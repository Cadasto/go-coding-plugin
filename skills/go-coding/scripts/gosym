#!/usr/bin/env bash
# gosym: one Go symbol question in one call. It finds the symbol's definition with
# `gopls workspace_symbol`, then asks gopls at that position, so nobody copies a position by hand.
#
#   gosym [-C <checkout>] def|refs|impl|calls <Name> [<path part>]
#
#   def    where <Name> is defined
#   refs   every use, resolved by type (gopls references)
#   impl   an interface's types, or the interfaces a type satisfies (gopls implementation)
#   calls  the callers and callees of a function or method (gopls call_hierarchy)
#
# <Name> is a package-level name (ParseQuery) or a method (Decoder.Decode); a bare name also matches
# every method of that name. Only definitions inside the checkout count, not the standard library or
# the module cache. <path part> keeps the definitions whose path contains it, for a name declared in
# more than one package. Each definition prints as "== <path>:<line>:<col>-<col> <Name> <Kind>", its
# answers below it; paths print relative to the checkout.
#
# Exit 0 with the answers; 1 when no definition matches; 2 on a usage error; 3 when gopls is missing
# or fails. On 1 or 3, use grep and say so.
set -u

usage() {
  echo "usage: gosym [-C <checkout>] def|refs|impl|calls <Name> [<path part>]" >&2
  exit 2
}

dir=.
if [ "${1:-}" = "-C" ]; then
  [ $# -ge 2 ] || usage
  dir="$2"
  shift 2
fi
[ $# -ge 2 ] && [ $# -le 3 ] || usage
cmd="$1"; name="$2"; part="${3:-}"
case "$cmd" in
  def) sub="" ;;
  refs) sub=references ;;
  impl) sub=implementation ;;
  calls) sub=call_hierarchy ;;
  *) usage ;;
esac
case "$name" in
  ''|*[!A-Za-z0-9_.]*) echo "gosym: '$name' is not a Go name (Name or Type.Method)" >&2; exit 2 ;;
esac

cd "$dir" 2>/dev/null || { echo "gosym: no such directory: $dir" >&2; exit 2; }
physical="$(pwd -P)/"
logical="$(pwd -L)/"
command -v gopls >/dev/null 2>&1 || { echo "gosym: gopls is not on PATH; use grep and say so" >&2; exit 3; }

# Strip the checkout's own prefix, in either spelling, from every path in the text.
rel() {
  awk -v a="$physical" -v b="$logical" '
    function strip(s, p,   out, i) {
      out = ""
      while ((i = index(s, p)) > 0) { out = out substr(s, 1, i - 1); s = substr(s, i + length(p)) }
      return out s
    }
    { s = strip($0, a); if (b != a) s = strip(s, b); print s }'
}

# workspace_symbol lists at most 100 symbols and, past that cap, not reliably the exact one, so the
# query is anchored at the end ("Name$": every symbol whose name ends in it). It still matches loosely
# and reaches outside the checkout; keep the exact name, inside the checkout, under the path part.
if ! syms="$(gopls workspace_symbol -matcher fuzzy "$name\$" 2>&1)"; then
  printf 'gosym: gopls workspace_symbol failed: %s\n' "$syms" | rel >&2
  exit 3
fi
if [ "$(printf '%s\n' "$syms" | grep -c .)" -ge 100 ]; then
  echo "gosym: gopls stopped at 100 symbols ending in $name, so a definition may be missing; name it as Type.Method or add a path part" >&2
fi
defs="$(printf '%s\n' "$syms" | awk -v name="$name" -v a="$physical" -v b="$logical" -v part="$part" '
  index($1, a) != 1 && index($1, b) != 1 { next }
  $2 == name || (index(name, ".") == 0 && length($2) > length(name) && substr($2, length($2) - length(name)) == "." name) {
    if (part == "" || index($1, part) > 0) print
  }')"
if [ -z "$defs" ]; then
  echo "gosym: no definition of $name in ${logical%/}${part:+ under a path containing $part}; use grep and say so" >&2
  exit 1
fi

status=0
while IFS= read -r line; do
  printf '== %s\n' "$line" | rel
  [ -n "$sub" ] || continue
  pos="${line%% *}"
  if ! out="$(gopls "$sub" "$pos" 2>&1)"; then
    printf 'gosym: gopls %s %s failed: %s\n' "$sub" "$pos" "$out" | rel >&2
    status=3
    continue
  fi
  if [ -n "$out" ]; then printf '%s\n' "$out" | rel; else echo "(none)"; fi
done <<EOF
$defs
EOF
exit "$status"
